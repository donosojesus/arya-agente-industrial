# ARYA Industrial Demo - configuracion local del notebook.
# scripts/start-demo crea .env a partir de este archivo y genera el token automaticamente.
# .env nunca se sube a Git.

# Token de los controles del presentador (INJECT FAULT / NORMAL / RESET). Minimo 24 caracteres.
DEMO_CONTROL_TOKEN=replace-with-a-generated-local-token

# CMMS: clave del agente (solo crea borradores) y token humano (aprueba/rechaza). Deben ser distintos.
CMMS_AGENT_KEY=replace-with-a-generated-local-token
CMMS_APPROVER_TOKEN=replace-with-a-generated-local-token

# Agente ARYA
AGENT_ADMIN_TOKEN=replace-with-a-generated-local-token
AGENT_NODE_LABEL=Notebook (desarrollo)
# Modelo de lenguaje en la GB10. Vacio = sin modelo: ARYA lo informa y no responde preguntas.
# Confirmado el 19-10-2026: NIM en la GB10, API compatible con OpenAI, contexto de 32 000 tokens.
NEMOTRON_BASE_URL=http://gb10.local:30081/v1
NEMOTRON_MODEL=nvidia/nemotron-3-nano
# Razonamiento del modelo: off = menos de 1 s por paso; on = unos 15 s por paso.
LLM_THINKING=off
# Streaming: permite medir TTFT y TPOT. Si diera problemas con el modelo, poner off.
LLM_STREAM=on
NEMOTRON_API_KEY=
AGENT_PROACTIVE=off

# Puertos publicados en el notebook (loopback por defecto).
SCADA_BIND=127.0.0.1
SCADA_PORT=8080
CONTROL_PORT=9001
OPCUA_BIND=127.0.0.1
OPCUA_PORT=4840
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=8081
CMMS_BIND=127.0.0.1
CMMS_PORT=8082
AGENT_PORT=8091
UI_PORT=8090

# Escenario
FAULT_DURATION_SECONDS=180
RECOVERY_SECONDS=90
TICK_SECONDS=0.5

# SCADA
SAMPLE_SECONDS=1
STALE_AFTER_SECONDS=5

# Historian
HISTORIAN_RETENTION_DAYS=7
